# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication (synthetic demo credentials only)
JWT_SECRET=change-this-local-demo-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_OWNER_EMAIL=owner@kopiarunika.demo
DEMO_OWNER_PASSWORD=Demo123!
DEMO_STAFF_EMAIL=staff@kopiarunika.demo
DEMO_STAFF_PASSWORD=Demo123!

# PostgreSQL
POSTGRES_USER=umkm
POSTGRES_PASSWORD=umkm_local_password
POSTGRES_DB=umkm_finance
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://umkm:umkm_local_password@localhost:5433/umkm_finance

# Redis and Celery
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# MinIO / S3-compatible storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=umkm_minio
S3_SECRET_KEY=umkm_minio_password
S3_BUCKET=umkm-documents
S3_REGION=us-east-1

# Document ingestion
MAX_UPLOAD_BYTES=10485760
AMOUNT_TOLERANCE=1.00
MAX_FUTURE_DAYS=7
MINIMUM_EXTRACTION_CONFIDENCE=0.75
RECONCILIATION_AUTO_MATCH_THRESHOLD=90
RECONCILIATION_REVIEW_THRESHOLD=70
RECONCILIATION_AMBIGUITY_MARGIN=10
REMINDER_DUE_SOON_DAYS=7
REMINDER_COOLDOWN_DAYS=7
REMINDER_SCHEDULER_HOUR=8

# Local email outbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=finance@kopiarunika.demo
SMTP_TIMEOUT_SECONDS=5

# Extraction provider (mock works without an API key)
AI_PROVIDER=mock
AI_HTTP_ENDPOINT=
AI_HTTP_API_KEY=
AI_HTTP_MODEL=finance-document-extractor
EXTRACTION_PROMPT_VERSION=finance-inbox-v1
EXTRACTION_SCHEMA_VERSION=document-v1

# Local email sandbox
SMTP_HOST=mailpit
SMTP_PORT=1025
